{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://mikecann.blog/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "mikecann.co.uk"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://mikecann.blog/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.mikecann.co.uk"
        }
      ]
    }
  ]
}
