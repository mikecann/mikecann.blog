# Response headers for the Worker's static assets (Cloudflare reads this file from dist/).
# The same headers next.config.js set on Vercel, plus the HSTS header Vercel added itself.

/*
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Post media, thumbnails and site images: a day fresh in browsers, then stale while revalidating
# for a week.
/posts/:slug/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/thumbs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Astro's bundles have content hashes in their names, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
