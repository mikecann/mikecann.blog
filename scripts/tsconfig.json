{
  // The root tsconfig excludes scripts/ (they run with bun, not in Next.js); this checks them.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["bun"]
  },
  "include": ["./**/*.ts"],
  // Override the root exclude list, which excludes scripts/ itself.
  "exclude": []
}
