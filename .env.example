# Copy to .env and fill in what you need; bun loads .env and .env.local automatically.
# See the "Environment variables" section of README.md for where each one is set.

# Written to .env.local by `convex dev`; don't set them here.
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# uploadPostsToConvex --production uses this URL (falls back to NEXT_PUBLIC_CONVEX_URL)
NEXT_PUBLIC_CONVEX_URL_PROD=

# uploadPostsToConvex; must match BLOG_POST_ADMIN_TOKEN in the Convex deployment's environment
BLOG_POST_ADMIN_TOKEN=

# populateAlgolia (ALGOLIA_APP_ID is optional)
ALGOLIA_ADMIN_KEY=
ALGOLIA_APP_ID=

# Serve post media from Cloudflare R2 (optional; see "Serving media from Cloudflare R2" in README.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_ASSET_BASE_URL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Vercel only: the production deploy key used by `convex deploy`
# CONVEX_DEPLOY_KEY=

# Convex deployment environment: set with `bunx convex env set NAME value`, not here
# BLOG_POST_ADMIN_TOKEN=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# MAILCHIMP_API_KEY=
# MIKEBOT_DAILY_TOKEN_BUDGET=
# MIKEBOT_DAILY_COST_BUDGET_USD=
# MAILCHIMP_ALLOW_NON_PRODUCTION_SEND=
