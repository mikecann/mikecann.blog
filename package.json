{
  "name": "next-mikecann",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently --names \"next,convex\" --prefix-colors \"cyan,magenta\" \"bun run dev:next\" \"bun run dev:convex\"",
    "dev:next": "next dev --turbopack",
    "dev:convex": "convex dev",
    "generate": "bun run generateRSS && bun run generateSitemap && bun run generateThumbnails",
    "build": "bun run generate && next build --turbopack",
    "build-and-deploy": "if [ \"$VERCEL_ENV\" = \"production\" ]; then convex deploy --check-build-environment=disable --cmd 'bun run build && bun run syncAssets' && bun run populateAlgolia && bun run uploadPostsToConvex -- --production && bun run syncAssets -- --strip; else bun run build && bun run syncAssets -- --strip; fi",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p scripts",
    "dev:ts": "tsc --noEmit -w",
    "test": "vitest run",
    "dev:test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validatePosts": "bun run ./scripts/validatePosts.ts",
    "auditPosts": "bun run ./scripts/auditPosts.ts",
    "generateRSS": "bun run ./scripts/generateRSS.ts",
    "generateSitemap": "bun run ./scripts/generateSitemap.ts",
    "generateThumbnails": "bun run ./scripts/generateThumbnails.ts",
    "optimizeImages": "bun run ./scripts/optimizeImages.ts",
    "fixFlashLinks": "bun run ./scripts/fixFlashPlayableLinks.ts",
    "populateAlgolia": "bun run ./scripts/populateAlgolia.ts",
    "uploadPostsToConvex": "bun run ./scripts/uploadPostsToConvex.ts",
    "syncAssets": "bun run ./scripts/syncAssetsToR2.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.83",
    "algoliasearch": "^5.57.0",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "date-fns": "^4.4.0",
    "fluent-convex": "^0.13.0",
    "fp-ts": "^2.16.11",
    "gls": "^3.0.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "io-ts": "^2.2.22",
    "ldrs": "^1.1.9",
    "next": "^16.3.3",
    "p-limit": "^7.3.3",
    "posthog-js": "^1.421.0",
    "ramda": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.24.0",
    "rss": "^1.2.2",
    "typestyle": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/rss": "^0.0.32",
    "aws4fetch": "^1.0.20",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
